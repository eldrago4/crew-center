{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crew-center",
  // Points at the wrapper (worker.js) rather than .open-next/worker.js directly:
  // the wrapper re-exports OpenNext's fetch + Durable Objects and adds a
  // scheduled() handler for the Cron Triggers below. opennextjs-cloudflare's
  // deploy/preview just run `wrangler`, which honours this `main`.
  "main": "worker.js",
  // Cloudflare Cron Triggers — the Workers replacement for Vercel Cron. Each
  // expression is dispatched to worker.js's scheduled() handler, which maps it
  // to the matching /api/*/cron route. Keep these in sync with CRON_ROUTES in
  // worker.js. Times are UTC; adjust to taste.
  "triggers": {
    "crons": [
      "0 3 * * *",
      "0 4 1 * *"
    ]
  },
  // Required on the Workers Free plan (3 MiB gzipped script limit). OpenNext
  // emits an already-minified handler.mjs, but wrangler's own esbuild pass
  // re-prints it — the 2.5k-line handler becomes 202k lines inside worker.js,
  // which pushed the upload to 3131 KiB gzipped and hard-failed deploy with
  // "exceeded the size limit of 3 MiB" [code: 10027]. Minifying on upload
  // brings it back to ~2790 KiB. Note this also renames identifiers (esbuild
  // minifyIdentifiers), which OpenNext deliberately avoids in its own bundle,
  // so any wrangler/Next upgrade should be re-smoke-tested under `cf:preview`.
  "minify": true,
  "compatibility_date": "2026-07-14",
  // nodejs_compat is required: firebase-admin, drizzle and the Neon driver all
  // reach for Node built-ins. enable_nodejs_process_v2 keeps process.env working.
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    // NextAuth only auto-trusts the request host on Vercel. Without this,
    // every auth call on Workers fails with UntrustedHost and login bbreaks.
    "AUTH_TRUST_HOST": "true",
    // Base URL of the flight-recommender worker. The matching RECS_API_KEY is a
    // secret (wrangler secret put RECS_API_KEY), not a var. Keep the canonical
    // .com API endpoint here so the backend can serve the migrated domain.
    "RECS_API_URL": "https://api.indianvirtual.com"
  },
  // Workers AI binding — used by the AI.g assistant to query the AI Search
  // (AutoRAG) instance "soft-dew-c29d": env.AI.autorag("soft-dew-c29d").aiSearch(...).
  // Accessed in route handlers via getCloudflareContext().env.AI.
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
