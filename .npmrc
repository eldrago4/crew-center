# Speed up dependency installation (local + Cloudflare Workers Builds CI).
# Each of these trims work npm does on every `npm ci` / `npm install`:
#   audit        — skips the post-install vulnerability audit (a network call)
#   fund         — skips the funding-message pass
#   progress     — no progress-bar rendering in non-interactive CI
#   prefer-offline — reuse the package cache when present, only hit the network
#                    on a cache miss (big win once build caching is enabled)
#   loglevel     — less log churn
audit=false
fund=false
progress=false
prefer-offline=true
loglevel=error
